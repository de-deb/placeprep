DATABASE_URL="postgresql://placeprep:placeprep@localhost:5432/placeprep?schema=public"
JWT_SECRET="dev-secret-change-me-please-override"
JWT_EXPIRES_IN="7d"
PORT=5000
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"
# Sandboxed code execution (self-hosted Piston; see compose.yaml + README).
# Inside Docker Compose the backend uses http://piston:2000/api/v2 instead.
PISTON_URL="http://localhost:2000/api/v2"
EXECUTION_HTTP_TIMEOUT_MS=20000
